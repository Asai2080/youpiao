{
  "config_version": "1.1.0",
  "feature_scale": [
    0,
    1
  ],
  "precheck": {
    "required": "verified_name_pool",
    "different_destinations": {
      "result": "ALLOWED_WHEN_USER_REQUESTS_FUSION",
      "action": "Preserve each source identity and never claim a shared city."
    },
    "empty_verified_name_pool": {
      "result": "BLOCKED_UNVERIFIED_PRIMARY_TITLE",
      "action": "Stop before generation; never infer a place from visual style."
    }
  },
  "algorithm": {
    "kind": "deterministic_additive",
    "apply_hard_gates_before_scoring": true,
    "one_style_only": true,
    "direct_select_margin": 12,
    "confidence_bands": {
      "high": {
        "min": 80
      },
      "medium": {
        "min": 65,
        "max": 79.999
      },
      "low": {
        "min": 50,
        "max": 64.999
      },
      "compatibility_review": {
        "max": 49.999
      }
    },
    "ratio_compatibility_weight_cap": 5,
    "selected_prompt_must_be_available": true,
    "fallback_style_id": "MULTI_STYLE_01",
    "randomization": false
  },
  "title_selection": {
    "strategy": "RANDOM_FROM_UNION_VERIFIED_NAME_POOL",
    "randomization_scope": "PRIMARY_TITLE_ONLY",
    "deduplicate": true,
    "allowed_kinds": [
      "building",
      "attraction",
      "city",
      "place"
    ],
    "allow_country_primary_title": false,
    "allow_outside_pool": false,
    "empty_pool_result": "BLOCKED_UNVERIFIED_PRIMARY_TITLE"
  },
  "styles": {
