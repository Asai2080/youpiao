{
  "config_version": "1.1.0",
  "feature_scale": [
    0,
    1
  ],
  "algorithm": {
    "kind": "deterministic_additive",
    "apply_hard_gates_before_scoring": true,
    "one_style_only": true,
    "direct_select_margin": 12,
    "confidence_bands": {
      "high": {
        "min": 80
      },
      "medium": {
        "min": 65,
        "max": 79.999
      },
      "low": {
        "min": 50,
        "max": 64.999
      },
      "compatibility_review": {
        "max": 49.999
      }
    },
    "ratio_compatibility_weight_cap": 5,
    "selected_prompt_must_be_available": true,
    "fallback_style_id": "STYLE_01",
    "randomization": false
  },
  "title_selection": {
    "strategy": "MOST_SPECIFIC_FROM_VERIFIED_NAME_POOL",
    "allowed_kinds": [
      "building",
      "attraction",
      "city",
      "place"
    ],
    "allow_country_primary_title": false,
    "allow_outside_pool": false,
    "empty_pool_result": "BLOCKED_UNVERIFIED_PRIMARY_TITLE"
  },
  "styles": {
    "STYLE_03": {
      "hard_gates": [
        {
          "feature": "scores.linear_landmark_score",
          "operator": ">=",
          "value": 0.65,
          "reason": "Linear landmark is mandatory."
        }
      ],
      "score_rules": [
        {
          "feature": "scores.linear_landmark_score",
          "operator": ">=",
          "value": 0.75,
          "weight": 50,
          "note": "Strong linear landmark"
        },
        {
          "feature": "scores.perspective_depth_score",
          "operator": ">=",
          "value": 0.7,
          "weight": 25,
          "note": "Strong perspective depth"
        },
        {
          "feature": "flags.repeating_structure",
          "operator": "==",
          "value": true,
          "weight": 15,
          "note": "Repeating structure"
        },
        {
          "feature": "flags.large_environment_visible",
          "operator": "==",
          "value": true,
          "weight": 10,
          "note": "Large environment visible"
        },
        {
          "feature": "flags.central_single_monument",
          "operator": "==",
          "value": true,
          "weight": -25,
          "note": "Central single monument conflicts"
        },
        {
          "feature": "flags.isolated_civic_building",
          "operator": "==",
          "value": true,
          "weight": -30,
          "note": "Isolated civic building conflicts"
        }
      ],
      "invalid_rules": [
        {
          "feature": "scores.linear_landmark_score",
          "operator": "<",
          "value": 0.65,
          "effect": "INVALID",
          "note": "No qualifying linear structure"
        }
      ]
    },
